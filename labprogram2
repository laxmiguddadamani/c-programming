#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n,t1=0,t2=1,next_term;
    printf("enter number of term:");
    scanf("%d",&n);
    printf("fibonacci series");
    for(int i=1;i<=n;i++){
        printf("%d",t1);
        next_term = t1+t2;
        t1=t2;
        t2=next_term;
    }
    return 0;
}
