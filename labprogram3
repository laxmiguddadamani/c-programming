#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n,is_prime=1;
    printf("enter an integear");
    scanf("%d",&n);
    if(n<=1){
        is_prime=0;
    }else{
        for(int i=2;i<n;i++){
            if(n%i==0){
                is_prime=0;
                break;
            }
        }
    }
    if(is_prime==1){
        printf("prime number");
    }else{
        printf("not prime number");
    }
    return 0;
}
